#include <iostream>
#include <string>
using namespace std;

string caesar(string text, int shift) {
    shift %= 26;
    for (char &ch : text) {
        if (isupper(ch))
            ch = 'A' + (ch - 'A' + shift + 26) % 26;
        else if (islower(ch))
            ch = 'a' + (ch - 'a' + shift + 26) % 26;
    }
    return text;
}

int main() {
    cout << "=== Caesar Cipher ===" << endl;
    string text;
    int shift;
    cout << "Text: ";
    getline(cin, text);
    cout << "Shift (1-25): ";
    cin >> shift;
    shift %= 26;
    string encrypted = caesar(text, shift);
    string decrypted = caesar(encrypted, -shift);
    cout << "Encrypted: " << encrypted << endl;
    cout << "Decrypted: " << decrypted << endl;
    return 0;
}
